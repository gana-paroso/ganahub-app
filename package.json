{
  "name": "ganahub",
  "version": "2.0.1",
  "description": "개발팀 프로젝트 정보 관리와 개발자 개인 도구 통합 앱",
  "author": "gana-paroso",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gana-paroso/ganahub-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gana-paroso/ganahub-app.git"
  },
  "bugs": {
    "url": "https://github.com/gana-paroso/ganahub-app/issues"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@primno/dpapi": "^2.0.1",
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "com.ganahub.app",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@primno/dpapi/**"
    ],
    "productName": "GanaHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "ui/**",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "GanaHub-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1042",
      "createDesktopShortcut": true,
      "shortcutName": "GanaHub"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gana-paroso",
        "repo": "ganahub-app"
      }
    ]
  }
}
